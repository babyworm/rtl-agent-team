{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "findings",
    "resolved_items",
    "summary",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "file",
          "line",
          "description",
          "suggestion"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major",
              "minor",
              "suggestion"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "correctness",
              "performance",
              "architecture",
              "spec-compliance",
              "style",
              "security"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "type": [
              "integer",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "suggestion": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "resolved_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "comment"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted_fix",
              "accepted_rebuttal",
              "still_disagree"
            ]
          },
          "comment": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "NEEDS_DISCUSSION"
      ]
    }
  }
}
