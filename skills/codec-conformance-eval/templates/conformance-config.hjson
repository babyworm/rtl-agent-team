{
  // codec-conformance-eval configuration
  // Decoder conformance evaluation against official bitstreams.

  // NOTE: This template defaults to H.264 Baseline.
  // For H.264, the primary mandatory sources are JCTVC (JCT-VC) and JVT.
  // JVET applies to H.265 (HEVC) / H.266 (VVC) — adjust conformance_sources accordingly.
  eval_name: "h264_baseline_decoder_conformance"

  // Target profile to test
  target: {
    standard: "h264"               // "h264" | "h265"
    profile: "Baseline"            // Profile name (for filtering/reporting)
    level: ""                      // Optional level filter (e.g., "4.1"). Empty = all levels
    // Resolution fields — required for psnr-threshold and SSIM/VMAF comparison modes.
    // Not needed for md5 or bitexact modes.
    // width: 1920
    // height: 1080
    // bit_depth: 8                // 8 or 10
    // chroma_format: "420"        // "420" | "422" | "444"
  }

  // Decoder configuration
  decoder: {
    decoder_src: "refc/src"
    decoder_binary: ".rat/scratch/conformance-eval/decoder"
    // Command template — variables: {decoder} {bitstream} {output} {extra_args}
    decoder_cmd_template: "{decoder} -b {bitstream} -o {output} {extra_args}"
    extra_args: ""
  }

  // Conformance stream sources (ordered by priority)
  // Auto-discovers *.264, *.h264, *.avc, *.265, *.h265, *.hevc files recursively from path.
  // Note: *.bin is excluded from auto-discovery to avoid false matches.
  // If conformance streams use .bin extension, list them explicitly in streams[].
  conformance_sources: [
    {
      id: "JVET"
      label: "ITU-T JVET Official"
      // Note: JVET applies to H.265 (HEVC) and H.266 (VVC), not H.264 (AVC).
      // For H.264 templates, this source is optional. Change to "mandatory"
      // when configuring H.265/H.266 conformance.
      path: "conformance/jvet/"
      // url: "https://www.itu.int/..."     // Download reference (informational)
      priority: "optional"
      // streams: []                         // Auto-discover from path if empty/absent
    }
    {
      id: "JCTVC"
      label: "JCT-VC Official"
      path: "conformance/jctvc/"
      priority: "mandatory"
    }
    {
      id: "allegro"
      label: "Allegro DVT"
      path: "conformance/3rd-party/allegro/"
      priority: "optional"
    }
    {
      id: "elecard"
      label: "Elecard StreamEye"
      path: "conformance/3rd-party/elecard/"
      priority: "optional"
    }
  ]

  // Golden output references (MD5 checksums or reference YUV files)
  golden: {
    path: "conformance/golden-outputs/"   // Directory or JSON file
    // Comparison mode:
    //   "md5"            — MD5 checksum comparison (fastest, default)
    //   "bitexact"       — Byte-by-byte comparison (reports mismatch offset)
    //   "psnr-threshold" — PSNR threshold (for approximate matching)
    comparison_mode: "md5"
    psnr_threshold: 100.0   // dB (only for psnr-threshold mode). Use very high value (e.g. 100) for near-bitexact. Lower values (e.g. 50) allow rounding tolerance.
  }

  // Quality metrics (opt-in only — add "ssim" / "vmaf" if needed)
  quality_metrics: ["psnr"]

  // Execution settings (same pattern as codec-rd-eval)
  execution: {
    mode: "local"              // "local" | "aws-batch"
    max_parallel: 8            // Concurrent decode processes
    timeout_per_job: 300       // Seconds per stream (decoding is faster than encoding)

    // AWS Batch settings (used only when mode="aws-batch")
    aws_batch: {
      region: "ap-northeast-2"
      job_queue: "codec-conformance-spot-queue"
      job_definition: "codec-conformance-job"
      spot: true
      max_vcpus: 32
      s3_bucket: "codec-eval-results"   // S3 bucket for conformance streams and results
      // Consumed by the submitter: region, job_queue, job_definition, s3_bucket.
      // The four below describe a compute environment you provision yourself
      // (console/CDK/Terraform) — the submitter only queues jobs, so changing
      // them here has no effect on a run.
      compute_env: "codec-conformance-spot-ce"
      instance_types: ["c5.xlarge", "c5.2xlarge"]
    }
  }

  // Output settings
  output: {
    report_path: "docs/phase-1-research/conformance-eval-report.md"
    raw_data_path: ".rat/scratch/conformance-eval"
    // Decoded YUV files are always preserved in raw_data_path (needed for PSNR/SSIM comparison)
  }
}
