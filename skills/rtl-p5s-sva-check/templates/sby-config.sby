# SymbiYosys Configuration Template
# Usage:
#   sby -f formal/{{MODULE}}.sby bmc
#   sby -f formal/{{MODULE}}.sby prove
#   sby -f formal/{{MODULE}}.sby cover
# Generates: formal/{{MODULE}}/
#
# OSS path: convert DUT RTL explicitly before SBY:
#   sv2v --write=formal/{{MODULE}}_v2v.v {{RTL_SRC_DIR}}/*.sv
# Keep full concurrent SVA (`assert property`, temporal operators, bind files)
# commercial-only. Do not pass it through sv2v.

[tasks]
bmc       # Bounded Model Checking
prove     # Induction proof
cover     # Reachability check

[options]
bmc: mode bmc
bmc: depth 30
prove: mode prove
prove: depth 30
cover: mode cover
cover: depth 30

[engines]
bmc: smtbmc boolector
prove: smtbmc boolector
cover: smtbmc boolector
# Alternatives:
#   smtbmc yices    — often fastest for bitvector-heavy designs
#   smtbmc z3       — best for arithmetic-heavy designs
#   abc pdr         — unbounded proof (prove mode only)

[script]
# SBY copies [files] into <outdir>/src. Read the destination basenames here,
# not their project-root source paths.
read -formal {{MODULE}}_v2v.v
read -formal -sv {{MODULE}}_formal_harness.sv
prep -top {{MODULE}}_formal_harness
# Fail before invoking a solver if the generated OSS harness did not elaborate
# into at least one immediate formal check cell.
select -assert-min 1 t:$check

[files]
# destination basename, then project-root source path
{{MODULE}}_v2v.v formal/{{MODULE}}_v2v.v
{{MODULE}}_formal_harness.sv formal/{{MODULE}}_formal_harness.sv
