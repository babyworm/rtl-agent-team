{
  "name": "rtl-agent-marketplace",
  "owner": {
    "name": "babyworm",
    "email": "babyworm@users.noreply.github.com"
  },
  "metadata": {
    "description": "RTL design and verification automation agents for Claude Code",
    "version": "0.7.8"
  },
  "plugins": [
    {
      "name": "rtl-agent-team",
      "source": "./",
      "description": "93-agent RTL design pipeline with 91 skills for 6-Phase hardware design automation (Research → Architecture → μArch → RTL → Verify → Design Note)",
      "version": "0.7.8",
      "author": {
        "name": "babyworm"
      },
      "homepage": "https://github.com/babyworm/rtl-agent-team",
      "repository": "https://github.com/babyworm/rtl-agent-team",
      "license": "MIT",
      "category": "development",
      "tags": [
        "rtl",
        "hdl",
        "verilog",
        "systemverilog",
        "fpga",
        "asic",
        "eda",
        "verification",
        "formal",
        "uvm",
        "cocotb"
      ]
    },
    {
      "name": "systemverilog-lsp",
      "source": "./plugins/systemverilog-lsp",
      "description": "SystemVerilog/Verilog language server for Claude Code, powered by slang-server (hudson-trading). Provides diagnostics, hover, completion, go-to-definition, references, rename, and inlay hints for .sv/.svh/.v/.vh files.",
      "version": "1.1.1",
      "author": {
        "name": "RTL Agent Team contributors"
      },
      "homepage": "https://github.com/hudson-trading/slang-server",
      "repository": "https://github.com/babyworm/rtl-agent-team",
      "license": "MIT",
      "category": "development",
      "tags": [
        "systemverilog",
        "verilog",
        "lsp",
        "hdl",
        "rtl",
        "slang"
      ],
      "strict": false,
      "lspServers": {
        "systemverilog": {
          "command": "slang-server",
          "args": [],
          "extensionToLanguage": {
            ".sv": "systemverilog",
            ".svh": "systemverilog",
            ".v": "verilog",
            ".vh": "verilog"
          }
        }
      }
    }
  ]
}
